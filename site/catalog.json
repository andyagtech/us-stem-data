    "taxonomy": {
      "description": "Canonical department taxonomy mapping 782 variant names to 44 standard categories",
      "format": "JSON",
      "url": "/data/taxonomy.json"
    }
  },
  "record_schema": {
    "description": "Each university JSON contains a records array. Each record is [dept, year, name, origin_class, confidence, title, url, degree_type]",
    "fields": [
      {
        "index": 0,
        "name": "department",
        "type": "string",
        "description": "Department or field of study (normalized via taxonomy)"
      },
      {
        "index": 1,
        "name": "year",
        "type": "integer",
        "description": "Year of thesis/dissertation completion"
      },
      {
        "index": 2,
        "name": "name",
        "type": "string",
        "description": "Author name (Last, First)"
      },
      {
        "index": 3,
        "name": "origin_classification",
        "type": "string",
        "description": "Name-based origin estimate: chinese, indian, korean, arabic, iranian, turkish, vietnamese, other, or empty"
      },
      {
        "index": 4,
        "name": "confidence",
        "type": "string",
        "description": "Classification confidence (currently unused)"
      },
      {
        "index": 5,
        "name": "title",
        "type": "string",
        "description": "Thesis/dissertation title (truncated to 90 chars)"
      },
      {
        "index": 6,
        "name": "url",
        "type": "string",
        "description": "URL to the institutional repository record"
      },
      {
        "index": 7,
        "name": "degree_type",
        "type": "string",
        "description": "phd, ms, or empty if unknown"
      }
    ],
    "enrichment_fields": {
      "enrollment": "NSF GSS graduate enrollment data (2024)",
